{
  "name": "universal-code-learning",
  "productName": "Code Learning",
  "version": "0.1.0",
  "private": true,
  "description": "Local, read-only code learning prototype",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "test:ai-sandbox": "node scripts/ai-sandbox-smoke.mjs",
    "test:codex-live": "vitest run --config vitest.live.config.ts tests/live/codex.live.ts",
    "test:agy-live": "vitest run --config vitest.live.config.ts tests/live/antigravity.live.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.2",
    "playwright": "1.64.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@xyflow/react": "12.12.0",
    "chokidar": "5.0.0",
    "ignore": "7.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.21.4",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  }
}
