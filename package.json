{
  "name": "universal-code-learning",
  "productName": "Code Learning",
  "version": "1.0.2",
  "private": true,
  "description": "Read-only app for exploring unfamiliar TypeScript and JavaScript projects",
  "license": "MIT",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "icons": "node scripts/make-icons.mjs",
    "package": "electron-forge package",
    "make": "electron-forge package --platform=darwin --arch=arm64 && node scripts/make-dmg.mjs",
    "make:win": "electron-forge make --platform=win32 --arch=x64",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "test:ai-sandbox": "node scripts/ai-sandbox-smoke.mjs",
    "test:codex-live": "vitest run --config vitest.live.config.ts tests/live/codex.live.ts",
    "test:plan-live": "vitest run --config vitest.live.config.ts tests/live/plan-compare.live.ts",
    "test:agy-live": "vitest run --config vitest.live.config.ts tests/live/antigravity.live.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.10.2",
    "electron-winstaller": "5.4.4",
    "playwright": "1.64.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@xyflow/react": "12.12.0",
    "chokidar": "5.0.0",
    "ignore": "7.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.21.4",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "fsevents@2.3.3": false,
    "tree-sitter@0.21.1": false,
    "tree-sitter-javascript@0.21.4": false,
    "tree-sitter-javascript@0.23.1": false,
    "tree-sitter-python@0.23.4": false,
    "tree-sitter-typescript@0.23.2": false
  }
}
